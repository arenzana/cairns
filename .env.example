# Copy to .env and fill in. .env is gitignored.

# --- Postgres (pgvector) ---------------------------------------------------
# Loopback-bound, but generate a real value anyway:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Embeddings ------------------------------------------------------------
# Ollama runs NATIVELY on the host, not in Docker: Docker Desktop on macOS has
# no GPU passthrough, so a containerised Ollama falls back to CPU and turns a
# 15-minute index into hours.
#   brew install ollama && ollama pull bge-m3
# The host must listen on 0.0.0.0 for containers to reach it (see README).
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=bge-m3
# Optional cross-check only. The authority is the chunks.embedding column, which
# cairns reads at startup; set this and it must agree or the process refuses to
# start. To actually change dimensions you must migrate the column and re-embed:
#   ALTER TABLE chunks ALTER COLUMN embedding TYPE vector(768);
#   docker compose run --rm cairnsd /usr/local/bin/cairnsd -once -reindex
# EMBED_DIMS=1024

# --- Filesystem source (the default, always on) ----------------------------
# The directory to index, as the HOST sees it. Mounted read-only.
FS_HOST_PATH=/path/to/your/notes
# Optional. Set this to your Obsidian vault NAME (not its path) and results
# become obsidian:// links that open the note in Obsidian. Leave empty for
# plain file paths.
OBSIDIAN_VAULT=

# --- Reranking (optional) --------------------------------------------------
# Without a key, search degrades to raw vector similarity and says so. With
# one, every candidate is judged for whether it actually answers the question.
# https://typesafe.ai
TYPESAFE_API_KEY=

# --- Twenty CRM source (optional plugin) -----------------------------------
# Leave TWENTY_API_KEY empty and the source is skipped entirely. To drop it
# from the binary as well, remove its blank import in cmd/cairnsd/main.go.
TWENTY_BASE_URL=
TWENTY_WEB_URL=
TWENTY_API_KEY=
