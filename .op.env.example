# Optional: pull secrets from 1Password at `docker compose up` time instead of
# writing them into .env. These are REFERENCES, not values, so this file is
# safe to commit; copy it to .op.env and point the paths at your own items.
#
#   op run --no-masking --env-file=.op.env -- docker compose up -d
#
# --no-masking matters: without it `op` substitutes <concealed> on the way into
# the container and the services start with garbage credentials.
TYPESAFE_API_KEY=op://vault/item/field
TWENTY_API_KEY=op://vault/item/field
